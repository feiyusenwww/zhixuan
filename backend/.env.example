# 后端环境变量样例
# 说明：当前 app/core/config.py 直接读取「进程环境变量」，不自动加载本文件。
#       用途是记录有哪些可调项、默认值是什么。
#       如需自动加载，可在启动前 export / set，或后续接入 python-dotenv。
# 注意：.env 已在 .gitignore 中，严禁提交任何密钥。

# 调试模式（生产环境建议设为 false）
ZHIXUAN_DEBUG=true

# 允许跨域的前端地址，多个用英文逗号分隔
ZHIXUAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# 数据库（tasks.md 1.4）
# ---------------------------------------------------------------------------
# 本地开发默认 SQLite，零安装即可跑通；切换 PostgreSQL 只需改这一个变量：
#   postgresql+psycopg://zhixuan:密码@localhost:5432/zhixuan
# 结构变更一律通过 alembic 迁移：cd backend && .venv/Scripts/alembic upgrade head
ZHIXUAN_DATABASE_URL=sqlite:///./.runtime/zhixuan.db

# 启动时自动建表（仅"创建缺失的表"，方便本地起步；结构变更请用 alembic）
ZHIXUAN_AUTO_CREATE_TABLES=true

# ---------------------------------------------------------------------------
# 认证（tasks.md 3.1、3.2）
# ---------------------------------------------------------------------------
# 令牌签名密钥：生产环境必须替换为随机值，且不少于 32 字节（HS256，RFC 7518 §3.2）
# 生成示例：python -c "import secrets;print(secrets.token_urlsafe(48))"
ZHIXUAN_SECRET_KEY=dev-only-secret-key-change-me-in-production
# 访问令牌有效期（分钟），默认 7 天
ZHIXUAN_TOKEN_TTL_MINUTES=10080
# 口令哈希迭代次数（PBKDF2-HMAC-SHA256）
ZHIXUAN_PASSWORD_ITERATIONS=260000
# 登录失败限流：窗口内失败次数上限 / 锁定时长（秒）
ZHIXUAN_LOGIN_MAX_FAILURES=5
ZHIXUAN_LOGIN_LOCK_SECONDS=300

# 运行环境标记：dev / production
ZHIXUAN_ENV=dev
