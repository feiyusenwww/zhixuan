# 后端环境变量样例
# 用法：复制为 .env 后按本机情况填写。.env 已在 .gitignore 中，切勿提交。

# 数据库（PostgreSQL 16 + pgvector）
DATABASE_URL=postgresql+psycopg://zhixuan:change-me@localhost:5432/zhixuan

# 令牌签名与有效期
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_MINUTES=1440
LOGIN_RATE_LIMIT=5

# 大模型（通义千问 qwen-plus）
LLM_API_KEY=

# 允许跨域的前端地址
CORS_ORIGINS=http://localhost:5173
